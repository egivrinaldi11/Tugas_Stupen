    {
      "parameters": {
        "jsCode": "let data;\n\n// Ambil output dari Gemini\nconst raw =\n  $json.output ||\n  $json.text ||\n  $json.response ||\n  $json.content ||\n  '';\n\n// Bersihkan markdown JSON jika ada\nconst cleaned = raw\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\ntry {\n  // Parse JSON dari AI\n  data = JSON.parse(cleaned);\n\n} catch (error) {\n\n  // Jika gagal parse\n  data = {\n    candidate_name: 'Unknown',\n    skills: ['Unknown'],\n    score: 50,\n    recommendation: 'Perlu Review',\n    summary: cleaned\n  };\n}\n\n// Return hasil final\nreturn [\n  {\n    json: {\n      candidate_name: data.candidate_name || 'Unknown',\n      skills: Array.isArray(data.skills)\n        ? data.skills.join(', ')\n        : data.skills || 'Unknown',\n\n      score: data.score || 0,\n\n      recommendation:\n        data.recommendation || 'Perlu Review',\n\n      summary: data.summary || '',\n\n      upload_date: new Date().toISOString()\n    }\n  }\n];"
      },
