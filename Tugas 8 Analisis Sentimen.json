    {
      "parameters": {
        "jsCode": "const items = $items(\"Baca Data\");\n\nlet positive = 0;\nlet negative = 0;\nlet neutral = 0;\n\nfor (const item of items) {\n  let sentiment = item.json.Sentiment;\n\n  if (!sentiment) continue;\n\n  // bersihkan data\n  sentiment = sentiment.toString().trim().toLowerCase();\n\n  if (sentiment === 'positive') {\n    positive++;\n  } else if (sentiment === 'negative') {\n    negative++;\n  } else if (sentiment === 'neutral') {\n    neutral++;\n  }\n}\n\nreturn [\n  {\n    json: {\n      total_data: items.length,\n      sentimen_positif: positive,\n      sentimen_negatif: negative,\n      sentimen_netral: neutral\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
